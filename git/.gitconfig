[user]
	email = micael.l.m.c@gmail.com
	name = Micael Carvalho

[includeIf "gitdir:~/cleanslate/"]
	path = .gitconfig-work

[core]
	editor = nvim
	excludesFile = ~/.gitignore_global

[init]
	defaultBranch = main

[fetch]
	prune = true

[pull]
	ff = only

[push]
	default = simple
	autoSetupRemote = true

[rerere]
	enabled = true

[diff]
	algorithm = histogram

[merge]
	conflictStyle = zdiff3
