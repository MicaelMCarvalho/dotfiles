# Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias -- -='cd -'

# Listings (macOS/BSD ls)
alias ls='ls -G'
alias l='ls -lG'
alias ll='ls -lhG'
alias la='ls -lhaG'
alias ld='ls -ldG -- */'

# Development
alias py='python3'
alias python='python3'
alias pip='python3 -m pip'
alias act='source venv/bin/activate'
alias venv='python3 -m venv venv'
alias npmls='npm list --depth=0'
alias npmi='npm install'
alias npmu='npm update'
alias dk='docker'
alias dkc='docker compose'
alias dkps='docker ps'
alias dkst='docker stats'

# Git and terminal tools
alias gfl='git flow'
alias lz='lazygit'
alias fzn='fzne'
alias nv='nvim -i "$HOME/.local/share/nvim/shada/$$"'
alias wez='open -a WezTerm'
alias nt='open -na iTerm'

# macOS helpers
alias flush-dns='sudo dscacheutil -flushcache && sudo killall -HUP mDNSResponder && echo "DNS cache flushed."'
alias ip='curl --fail --silent --show-error https://ipinfo.io | jq .'
alias ports='lsof -i -P -n | grep LISTEN'
alias sysprof='top -o cpu -stats pid,command,cpu,mem,time,state'
alias firefox='open -a Firefox'
alias rm='rm -i'

# Personal tools
alias rbt='robot -d out_files/'
alias awsdo='aws --endpoint-url=https://ams3.digitaloceanspaces.com'

# Flutter
alias fpg='flutter pub get'
alias frb='dart run build_runner build --delete-conflicting-outputs'
